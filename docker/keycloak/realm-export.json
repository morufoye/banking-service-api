{
  "realm": "banking",
  "displayName": "Banking Platform",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "emailTheme": "banking",
  "loginTheme": "banking",
  "accountTheme": "banking",
  "adminTheme": "banking",
  "defaultRoles": ["default-roles-banking"],
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN",
        "description": "Administrator role"
      },
      {
        "name": "ROLE_CLIENT",
        "description": "Client role"
      },
      {
        "name": "ROLE_VIEWER",
        "description": "Viewer role"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@bank.com",
      "firstName": "System",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["ROLE_ADMIN"],
      "groups": ["admins"]
    }
  ],
  "clients": [
    {
      "clientId": "banking-api",
      "name": "Banking API",
      "description": "Banking Onboarding Platform API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600",
        "refresh.token.lifespan": "86400"
      }
    },
    {
      "clientId": "banking-frontend",
      "name": "Banking Frontend",
      "description": "Banking Onboarding Platform Frontend",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "protocol": "openid-connect"
    }
  ],
  "groups": [
    {
      "name": "admins",
      "realmRoles": ["ROLE_ADMIN"]
    },
    {
      "name": "clients",
      "realmRoles": ["ROLE_CLIENT"]
    },
    {
      "name": "viewers",
      "realmRoles": ["ROLE_VIEWER"]
    }
  ],
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "noreply@bank.com",
    "auth": false,
    "ssl": false,
    "starttls": false
  }
}